# npm install copies this file to .env when there is none, and fills in the
# secrets (SECRETS_KEY and the tokens) with random values and the package limits
# (CODE_PACKAGES_*) that are missing; so does every deploy (scripts/setup-env.mjs).
# Adjust the rest. DATABASE_URL is required.

# --- Database (SQLite file, path relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Models
# Each user sets their own Ollama server and OpenAI / OpenRouter API keys on
# the account page (click your email in the sidebar).
# Ollama server for users who have not set their own (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# Default system prompt for Ollama models. Use \n for line breaks.
SYSTEM_PROMPT=You are llmlynx, a helpful, concise assistant. Use markdown where useful.
# Key that encrypts the users' API keys: 32 random bytes, base64 or hex. npm install
# creates one when it is missing. Without it, users cannot save API keys. If it
# changes, saved keys can no longer be read and have to be entered again.
# SECRETS_KEY=

# --- Agent tools (web search, page reading, screenshots, files, running code)
# The tool containers in docker-compose.yml. They are part of the app: they
# always run. npm install fills in their tokens; keep them in .env, not
# .env.local: compose reads them from .env.
# SEARCH_MCP_TOKEN=
# BROWSER_MCP_TOKEN=
# FILES_MCP_TOKEN=
# CODE_MCP_TOKEN=
# SEARXNG_SECRET=
# Runs of code and installs of packages at once on the whole server (default 2);
# each run takes a CPU core and up to 512 MB of memory
# CODE_MAX_CONCURRENCY=2
# Packages a chat installs (install_packages). Most one install may download, in
# GB; installs get 12 minutes per GB. ClamAV scans each file of a package on its
# own, up to 2 GB, the most it can scan.
CODE_PACKAGES_DOWNLOAD_GB=5
# Most a chat's installed packages may take, in GB
CODE_PACKAGES_INSTALLED_GB=10
# Days without use after which a chat's packages are removed; its next run installs them again
CODE_PACKAGES_EXPIRE_DAYS=7
# Only when the tool servers are not where docker-compose.yml publishes them:
# SEARCH_MCP_URL=http://127.0.0.1:8790/mcp
# BROWSER_MCP_URL=http://127.0.0.1:8791/mcp
# FILES_MCP_URL=http://127.0.0.1:8792/mcp
# CODE_MCP_URL=http://127.0.0.1:8794/mcp

# --- Security (prompt injections and malware), see docs/security.md
# The guard and ClamAV containers in docker-compose.yml scan web content and
# attached files on the server; nothing leaves it. They are part of the app:
# they always run, and content they cannot check is withheld. Keep these in
# .env, not .env.local: compose reads them for the containers.
# Required: the guard's bearer token (npm install fills it in)
GUARD_MCP_TOKEN=
# Only when the scanners are not where docker-compose.yml publishes them:
# GUARD_MCP_URL=http://127.0.0.1:8793/mcp
# The guard's model: 22m (default; fits a Raspberry Pi) or 86m (more accurate, also in
# other languages, several times slower). Changing it takes: docker compose build guard
# GUARD_MODEL=22m
# From which score (0 to 1) text counts as a prompt injection
# GUARD_THRESHOLD=0.5
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- Accounts
# Comma-separated emails allowed to sign up. Empty or unset allows everyone.
# ALLOWED_SIGNUP_EMAILS=you@example.com,teammate@example.com
# SESSION_COOKIE_NAME=app_session
# SESSION_MAX_DAYS=7

# --- Auth log (login, signup and password reset events)
# AUTH_LOG_DIR=logs
# AUTH_LOG_FILE=auth.log
