# Copy to .env (or .env.local) and adjust. DATABASE_URL is required; SECRETS_KEY is
# needed to store API keys.

# --- Database (SQLite file, path relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Models
# Each user sets their own Ollama server and OpenAI / OpenRouter API keys on
# the account page (click your email in the sidebar).
# Ollama server for users who have not set their own (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# Default system prompt for Ollama models. Use \n for line breaks.
SYSTEM_PROMPT=You are llmlynx, a helpful, concise assistant. Use markdown where useful.
# Key that encrypts the users' API keys: 32 random bytes, base64 or hex. Create one with
#   openssl rand -base64 32
# Without it, users cannot save API keys. If it changes, saved keys can no longer
# be read and have to be entered again.
# SECRETS_KEY=

# --- Accounts
# Comma-separated emails allowed to sign up. Empty or unset allows everyone.
# ALLOWED_SIGNUP_EMAILS=you@example.com,teammate@example.com
# SESSION_COOKIE_NAME=app_session
# SESSION_MAX_DAYS=7

# --- Auth log (login, signup and password reset events)
# AUTH_LOG_DIR=logs
# AUTH_LOG_FILE=auth.log
