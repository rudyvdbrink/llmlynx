generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Secrets are never stored in plain text: passwords and recovery codes as
// bcrypt hashes, session tokens as SHA-256 hashes, API keys encrypted.
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  recoveryCodeHash String?
  createdAt        DateTime          @default(now())
  sessions         Session[]
  conversations    Conversation[]
  agents           Agent[]
  providerSettings ProviderSetting[]
  requestSetups    RequestSetup[]
  uploads          Upload[]
  securityEvents   SecurityEvent[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // SHA-256 of the token in the session cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MessageRole {
  user
  assistant
  system
  tool // the result of a tool call
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  model     String?
  pinnedAt  DateTime? // set while the conversation is pinned to the top of the list
  cost      Float?    // what its replies cost at OpenAI and OpenRouter, in US dollars; null while none came from them
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  securityEvents SecurityEvent[]
  // The chat's sandbox: its files are the named attachments of its messages (see server/files/store.ts)
  sandboxRuns     SandboxRun[]
  sandboxPackages SandboxPackage[]
  sandboxLocks    SandboxLock[]
  sandboxRepos    SandboxRepo[]

  @@index([userId, updatedAt])
}

// One step of a conversation, shaped like the messages model APIs take, so the
// whole trace (reasoning, tool calls and their results) can be rebuilt or replayed.
// A reply that uses tools is several steps: an assistant message with toolCalls,
// a tool message per call, then the assistant message that answers.
model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  position       Int           // order in the conversation, from 0
  role           MessageRole
  content        String        // the text; "" for an assistant step that only calls tools
  reasoning      String?       // assistant: the model's reasoning (thinking) before its reply
  toolCalls      Json?         // assistant: [{ id, name, arguments }], the tools the model called
  toolCallId     String?       // tool: the toolCalls[].id this is the result of
  toolName       String?       // tool: the tool that produced it
  model          String?       // assistant: "<provider>:<model>" that wrote it, see lib/selection.ts
  setupId        String?       // assistant: what the model was given besides the conversation
  setup          RequestSetup? @relation(fields: [setupId], references: [id])
  // Anything else about the step, such as token usage, or data a provider needs
  // back to continue the conversation (for example signed reasoning). Tool
  // steps keep what the chat view shows of them: { label, icon, error }, and
  // what the security checks found in the result: security: { flag, score?, decision? }.
  metadata       Json?
  createdAt      DateTime      @default(now())
  attachments    MessageAttachment[]

  @@index([conversationId, position])
  @@index([setupId])
}

// A file that belongs to a message: one the user attached (user message), one
// a tool made (tool step: a file tool, a run of code or a download), or a
// screenshot a tool returned (tool step, no name). Stored in the database, so
// backups include it and deleting the conversation deletes it. The named ones
// are the chat's sandbox: the newest version of each name is the current one,
// older ones are its history (see server/files/store.ts).
model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  name      String?  // the file's path in the sandbox, such as "data.csv" or "out/plot.png"; null for a screenshot
  size      Int?     // bytes of data
  text      String?  // the file as the model reads it (markdown); null until converted
  info      Json?    // what converting it found, such as { pages, textlessPages } of a PDF, or { error }
  // Set on an image made from another attachment for the model, such as a
  // scanned PDF page or a smaller copy of a photo. The chat view does not show these.
  parentId  String?
  parent    MessageAttachment?  @relation("Derived", fields: [parentId], references: [id], onDelete: Cascade)
  derived   MessageAttachment[] @relation("Derived")
  // Where the file came from when not from the message itself: "code" (a run made or changed it,
  // or it was edited from such a file) or "internet" (web_fetch). Both are untrusted. null: the
  // user attached it (user message) or a file tool made it (tool step)
  origin    String?
  // A deletion: the run of this tool step deleted the file `name`. Holds no data
  deleted   Boolean  @default(false)
  // The version of the same file this one is a copy of, when undo_file put the file back to it
  restoredFrom String?
  // The prompt injection scans of the parts of its text the model read, by the SHA-256 of the
  // part: { [hash]: { flagged, score } }. Only untrusted files are scanned, when they are read
  scans     Json?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([parentId])
}

// A file the user attached in the composer and has not sent yet (a draft). It
// is checked when it is attached (see server/security/engine.ts) and moves
// into MessageAttachment when its message is sent. Drafts that are never sent
// are deleted after a day.
model Upload {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  data      Bytes
  text      String?  // the file as the model reads it (markdown); null for an image
  info      Json?    // what converting it found, as in MessageAttachment.info
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// A run of code (run_code) or an install of packages (install_packages) in a
// chat's sandbox, as the sandbox panel lists it. What the model got of it is
// the tool step of the call; this keeps all of what it printed (up to 1 MB).
model SandboxRun {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallId     String       // the call in the chat's trace
  kind           String       // "run" | "install"
  language       String       // run: "python" | "javascript" | "typescript" | "shell"; install: "pypi" | "npm"
  code           String       // the code, or the packages asked for
  output         String       // what it printed, or what pip or npm reported
  status         String       // "ok" | "error" | "timeout" | "stopped" | "withheld" | "blocked" | "skipped"
  durationMs     Int
  files          Json?        // what the run did to the sandbox: { changed: string[], deleted: string[] }
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// A package installed for a chat's runs (see install_packages).
model SandboxPackage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ecosystem      String       // "pypi" | "npm"
  name           String
  version        String
  requested      Boolean      // asked for by the model, rather than needed by another package
  installedAt    DateTime     @default(now())

  @@index([conversationId])
}

// Exactly what a chat's packages of one ecosystem are, so the code container
// can install them again after it removed them (unused for 30 days, see tools/code).
model SandboxLock {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ecosystem      String       // "pypi" | "npm"
  requested      Json         // what the model asked for, such as ["pandas>=2", "seaborn"]
  lock           String       // pypi: "name==version" lines; npm: the package-lock.json
  updatedAt      DateTime     @updatedAt

  @@id([conversationId, ecosystem])
}

// A git repository of a chat (see the git tool): a folder of its sandbox, whose
// files are its work tree, and its .git folder, kept here rather than as files
// of the sandbox, so that runs of code never see it.
model SandboxRepo {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  path           String       // its folder in the sandbox, such as "hello-world"; "" for the sandbox itself
  git            Bytes        // its .git folder, as a gzipped tar
  size           Int
  updatedAt      DateTime     @updatedAt

  @@id([conversationId, path])
}

// The audit log of the security checks: every scan, every warning and block
// before a tool call, and every choice a user made in a security dialog. It
// holds no content and no full URLs: a host and a SHA-256 hash only.
model SecurityEvent {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?       // null for a file that is not in a conversation yet
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tool           String?       // the tool whose call or result was checked; null for an attached file
  check          String        // "url" | "injection" | "virus" | "decision"
  verdict        String        // "allow" | "warn" | "block"
  reason         String        // such as "clean", "injection", "virus", "unchecked", "url_exfil"
  score          Float?        // the classifier's score, 0 to 1
  host           String?       // the host of the page or URL
  contentHash    String?       // SHA-256 of the content or URL that was checked
  durationMs     Int?          // how long the check took
  decision       String?       // what the user chose in a dialog
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

// What a model was given besides the conversation: the system prompt, the
// generation options and the tools it could call. Each distinct combination is
// stored once per user (found by `hash`) and shared by every reply made with
// it, so a long system prompt is not repeated per reply. Replies stored before
// these existed have no setup.
model RequestSetup {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash         String    // SHA-256 of the fields below, see server/chat/setup.ts
  systemPrompt String?   // null: the model got none (plain OpenAI and OpenRouter models)
  options      Json?     // generation options, such as an agent's settings
  tools        Json?     // tool definitions the model could call
  createdAt    DateTime  @default(now())
  messages     Message[]

  @@unique([userId, hash])
}

// Custom agent configurations
model Agent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Display name shown in UI; unique per user
  name         String

  // Base model: a selection such as "openrouter:<model>" (see lib/selection.ts).
  // Older agents hold a plain Ollama model name (e.g., "gemma3:1b", "mistral")
  baseModel    String

  // Optional custom system prompt
  systemPrompt String?

  // Generation settings as JSON, see lib/agentSettings.ts. Which options there
  // are depends on the provider: Ollama agents have all of its options, OpenAI
  // and OpenRouter agents only those the user set.
  settings     Json

  // Names of the tools turned on for the agent, e.g. ["web_search", "web_read"]
  // (see lib/agentTools.ts). null or []: none, the default.
  tools        Json?
  // Most tool calls per reply (0: no limit); after that the agent answers with what it has
  maxToolCalls Int      @default(7)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, updatedAt])
  @@unique([userId, name]) // prevent duplicate names per user
}

// A user's settings for one model provider. API keys must be readable to call
// the provider, so they are encrypted (AES-256-GCM with SECRETS_KEY), not hashed.
model ProviderSetting {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // "ollama" | "openai" | "openrouter"
  apiKeyEncrypted String?  // OpenAI and OpenRouter
  baseUrl         String?  // Ollama server address
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}
