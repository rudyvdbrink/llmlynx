generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Secrets are never stored in plain text: passwords and recovery codes as
// bcrypt hashes, session tokens as SHA-256 hashes, API keys encrypted.
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  recoveryCodeHash String?
  createdAt        DateTime          @default(now())
  sessions         Session[]
  conversations    Conversation[]
  agents           Agent[]
  providerSettings ProviderSetting[]
  requestSetups    RequestSetup[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // SHA-256 of the token in the session cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MessageRole {
  user
  assistant
  system
  tool // the result of a tool call
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  model     String?
  pinnedAt  DateTime? // set while the conversation is pinned to the top of the list
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

// One step of a conversation, shaped like the messages model APIs take, so the
// whole trace (reasoning, tool calls and their results) can be rebuilt or replayed.
// A reply that uses tools is several steps: an assistant message with toolCalls,
// a tool message per call, then the assistant message that answers.
model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  position       Int           // order in the conversation, from 0
  role           MessageRole
  content        String        // the text; "" for an assistant step that only calls tools
  reasoning      String?       // assistant: the model's reasoning (thinking) before its reply
  toolCalls      Json?         // assistant: [{ id, name, arguments }], the tools the model called
  toolCallId     String?       // tool: the toolCalls[].id this is the result of
  toolName       String?       // tool: the tool that produced it
  model          String?       // assistant: "<provider>:<model>" that wrote it, see lib/selection.ts
  setupId        String?       // assistant: what the model was given besides the conversation
  setup          RequestSetup? @relation(fields: [setupId], references: [id])
  // Anything else about the step, such as token usage, or data a provider needs
  // back to continue the conversation (for example signed reasoning).
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId, position])
  @@index([setupId])
}

// What a model was given besides the conversation: the system prompt, the
// generation options and the tools it could call. Each distinct combination is
// stored once per user (found by `hash`) and shared by every reply made with
// it, so a long system prompt is not repeated per reply. Replies stored before
// these existed have no setup.
model RequestSetup {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash         String    // SHA-256 of the fields below, see server/chat/setup.ts
  systemPrompt String?   // null: the model got none (OpenAI and OpenRouter)
  options      Json?     // generation options, such as an agent's settings
  tools        Json?     // tool definitions the model could call
  createdAt    DateTime  @default(now())
  messages     Message[]

  @@unique([userId, hash])
}

// Custom agent configurations
model Agent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Display name shown in UI; unique per user
  name         String

  // Base model name (e.g., "gemma3:1b", "mistral")
  baseModel    String

  // Optional custom system prompt
  systemPrompt String?

  // Generation settings as JSON for flexibility
  // {
  //   "mirostat": 0|1|2,
  //   "mirostat_eta": number,
  //   "mirostat_tau": number,
  //   "num_ctx": number,
  //   "repeat_last_n": number,
  //   "repeat_penalty": number,
  //   "temperature": number,
  //   "seed": number,
  //   "num_predict": number,
  //   "top_k": number,
  //   "top_p": number,
  //   "min_p": number
  // }
  settings     Json

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, updatedAt])
  @@unique([userId, name]) // prevent duplicate names per user
}

// A user's settings for one model provider. API keys must be readable to call
// the provider, so they are encrypted (AES-256-GCM with SECRETS_KEY), not hashed.
model ProviderSetting {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // "ollama" | "openai" | "openrouter"
  apiKeyEncrypted String?  // OpenAI and OpenRouter
  baseUrl         String?  // Ollama server address
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}
